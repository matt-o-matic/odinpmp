---
const { items = [], speed = 40, invert = false } = Astro.props;
---

<div class:list={['marquee', invert && 'marquee--invert']} role="presentation" aria-hidden="true">
	<div class="marquee__track" style={`animation-duration:${speed}s`}>
		{
			[0, 1].map(() => (
				<div class="marquee__row">
					{items.map((item: string) => (
						<span class="marquee__item mono">
							<span class="marquee__sep">◤</span>
							{item}
						</span>
					))}
				</div>
			))
		}
	</div>
</div>

<style>
	.marquee {
		position: relative;
		overflow: hidden;
		border-top: 1px solid rgba(237, 243, 251, 0.1);
		border-bottom: 1px solid rgba(237, 243, 251, 0.1);
		background:
			linear-gradient(90deg, rgba(87, 166, 255, 0.06) 0%, rgba(87, 166, 255, 0.02) 50%, rgba(87, 166, 255, 0.06) 100%),
			rgba(7, 17, 31, 0.6);
		color: var(--paper);
		padding: 0.75rem 0;
	}
	.marquee--invert {
		background: rgba(237, 243, 251, 0.04);
		color: var(--paper);
	}
	.marquee__track {
		display: flex;
		width: max-content;
		animation: scroll linear infinite;
	}
	.marquee__row {
		display: flex;
		align-items: center;
	}
	.marquee__item {
		display: inline-flex;
		align-items: center;
		gap: 1.25rem;
		padding-right: 2.25rem;
		font-size: 0.92rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		white-space: nowrap;
	}
	.marquee__sep {
		color: var(--accent);
		font-size: 0.8rem;
	}
	@keyframes scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.marquee__track {
			animation: none;
		}
	}
</style>
