---
const year = new Date().getFullYear();
---

<footer class="ft">
	<div class="ft__grid">
		<div class="ft__brand">
			<div class="ft__brand-row">
				<img class="ft__mark" src="/brand/odin-mark.png" alt="" width="80" height="80" />
				<div>
					<div class="ft__lockup display">ODIN<span class="ft__lockup-accent">PMP</span></div>
					<p class="ft__tag mono">// PROJECT COMMAND //</p>
				</div>
			</div>
		</div>

		<div class="ft__col">
			<h4 class="mono">PRODUCT</h4>
			<ul>
				<li><a href="/#how">Command Flow</a></li>
				<li><a href="/#evidence">Evidence</a></li>
				<li><a href="/#manifesto">Manifesto</a></li>
				<li><a href="/signup">Waitlist</a></li>
			</ul>
		</div>

		<div class="ft__col">
			<h4 class="mono">CHANNELS</h4>
			<ul>
				<li><a href="/app">App entry</a></li>
				<li><a href="mailto:hello@odinpmp.com">hello@odinpmp.com</a></li>
			</ul>
		</div>

		<div class="ft__col">
			<h4 class="mono">STATUS</h4>
			<ul class="mono ft__status">
				<li><span class="dot"></span> SYSTEM: COMMAND BUILD</li>
				<li><span class="dot dot--green"></span> WAITLIST: OPEN</li>
				<li><span class="dot dot--ochre"></span> BETA: STAGING</li>
			</ul>
		</div>
	</div>

	<div class="ft__rule"></div>

	<div class="ft__legal mono">
		<span>© {year} ODINPMP</span>
		<span class="ft__legal-mid">PROJECT COMMAND — PRIVATE BETA</span>
		<nav class="ft__legal-links" aria-label="Legal">
			<a href="/privacy/">Privacy Policy</a>
			<a href="/terms/">Terms of Service</a>
		</nav>
	</div>
</footer>

<style>
	.ft {
		margin-top: 4rem;
		padding: 3rem 1.5rem 1.5rem;
		background:
			radial-gradient(circle at top left, rgba(87, 166, 255, 0.16), transparent 34%),
			linear-gradient(180deg, #0a1525 0%, #07111f 100%);
		color: var(--paper);
		border-top: 1px solid rgba(237, 243, 251, 0.08);
	}
	.ft__grid {
		display: grid;
		grid-template-columns: 1.4fr repeat(3, 1fr);
		gap: 2rem;
		max-width: 1400px;
		margin: 0 auto;
	}
	.ft__brand {
		grid-column: span 1;
	}
	.ft__brand-row {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.ft__mark {
		display: block;
		width: 80px;
		height: 80px;
		filter: drop-shadow(0 12px 24px rgba(87, 166, 255, 0.12));
	}
	.ft__lockup {
		font-size: clamp(2.2rem, 4vw, 3.6rem);
		line-height: 0.85;
	}
	.ft__lockup-accent {
		color: var(--accent);
	}
	.ft__tag {
		margin: 0.45rem 0 0;
		font-size: 0.8rem;
		letter-spacing: 0.14em;
		color: var(--ochre);
	}
	.ft__col h4 {
		margin: 0 0 0.9rem;
		font-size: 0.75rem;
		letter-spacing: 0.16em;
		color: var(--ochre);
	}
	.ft__col ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.45rem;
	}
	.ft__col a {
		font-size: 0.95rem;
		border-bottom: 1px solid transparent;
		color: rgba(237, 243, 251, 0.82);
	}
	.ft__col a:hover {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}
	.ft__status {
		font-size: 0.75rem;
		letter-spacing: 0.1em;
	}
	.ft__status li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.dot {
		display: inline-block;
		width: 9px;
		height: 9px;
		background: var(--accent);
		animation: pulse 1.8s ease-in-out infinite;
	}
	.dot--green {
		background: #6cc04a;
	}
	.dot--ochre {
		background: var(--ochre);
	}
	@keyframes pulse {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.3; }
	}

	.ft__rule {
		max-width: 1400px;
		margin: 2.5rem auto 1rem;
		height: 1px;
		background: rgba(237, 243, 251, 0.12);
	}
	.ft__legal {
		max-width: 1400px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		color: var(--paper);
		opacity: 0.7;
	}
	.ft__legal-mid {
		color: var(--accent);
		opacity: 1;
	}
	.ft__legal-links {
		display: flex;
		gap: 1rem;
		letter-spacing: 0.04em;
	}
	.ft__legal-links a {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.ft__legal-links a:hover {
		color: var(--accent);
	}
	.ft__legal-links a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
	}
	@media (max-width: 880px) {
		.ft__grid {
			grid-template-columns: 1fr 1fr;
		}
		.ft__legal {
			flex-direction: column;
			align-items: center;
			gap: 0.4rem;
			text-align: center;
		}
	}
	@media (max-width: 640px) {
		.ft__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.5rem;
		}
		.ft__brand {
			grid-column: 1 / -1;
		}
	}
</style>
