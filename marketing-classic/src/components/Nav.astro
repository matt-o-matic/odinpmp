---
const { current = '' } = Astro.props;
const links = [
	{ href: '/', label: 'INDEX', key: 'index' },
	{ href: '/#how', label: 'COMMAND FLOW', key: 'forge' },
	{ href: '/#evidence', label: 'EVIDENCE', key: 'evidence' },
	{ href: '/#manifesto', label: 'MANIFESTO', key: 'manifesto' },
	{ href: '/signup', label: 'WAITLIST', key: 'signup' },
];
---

<header class="nav">
	<a class="nav__mark" href="/" aria-label="OdinPMP home">
		<img class="nav__mark-icon" src="/brand/odin-mark.png" alt="" width="52" height="52" />
		<span class="nav__mark-copy">
			<span class="nav__mark-text">ODINPMP</span>
			<span class="nav__mark-tag mono">COMMAND STUDIO // BETA</span>
		</span>
	</a>
	<nav class="nav__links mono" aria-label="Primary">
		{
			links.map((l) => (
				<a href={l.href} class:list={['nav__link', current === l.key && 'nav__link--current']}>
					{l.label}
				</a>
			))
		}
	</nav>
	<a class="nav__cta mono" href="/signup">
		<span>REQUEST_BETA_KEY</span>
		<span aria-hidden="true">→</span>
	</a>
</header>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 50;
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 1.5rem;
		padding: 0.9rem 1.25rem;
		background: rgba(7, 17, 31, 0.82);
		border-bottom: 1px solid rgba(237, 243, 251, 0.1);
		backdrop-filter: blur(18px);
	}

	.nav__mark {
		display: inline-grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: 0.75rem;
	}
	.nav__mark-icon {
		display: block;
		width: 52px;
		height: 52px;
		filter: drop-shadow(0 8px 18px rgba(87, 166, 255, 0.16));
	}
	.nav__mark-copy {
		display: flex;
		flex-direction: column;
		gap: 0.12rem;
	}
	.nav__mark-text {
		font-family: 'Archivo Black', sans-serif;
		font-size: 1.02rem;
		letter-spacing: 0.04em;
		color: var(--bone);
		line-height: 1;
	}
	.nav__mark-tag {
		font-size: 0.67rem;
		color: rgba(237, 243, 251, 0.72);
		font-weight: 600;
		letter-spacing: 0.14em;
	}

	.nav__links {
		display: flex;
		justify-content: center;
		gap: 1.4rem;
		font-size: 0.78rem;
		font-weight: 700;
	}
	.nav__link {
		position: relative;
		padding: 0.25rem 0;
		color: rgba(237, 243, 251, 0.72);
	}
	.nav__link:hover {
		color: var(--accent);
	}
	.nav__link--current::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.35rem;
		height: 2px;
		background: var(--accent);
	}

	.nav__cta {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.6rem 0.95rem;
		background: linear-gradient(135deg, rgba(87, 166, 255, 0.18), rgba(40, 94, 198, 0.32));
		color: var(--bone);
		font-size: 0.78rem;
		font-weight: 700;
		border: 1px solid rgba(87, 166, 255, 0.45);
		transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
	}
	.nav__cta:hover {
		border-color: rgba(255, 255, 255, 0.72);
		transform: translateY(-2px);
		box-shadow: 0 14px 30px rgba(8, 28, 56, 0.28);
	}

	@media (max-width: 880px) {
		.nav {
			grid-template-columns: auto auto;
		}
		.nav__links {
			display: none;
		}
	}

	@media (max-width: 640px) {
		.nav {
			padding: 0.75rem 1rem;
			gap: 0.9rem;
			grid-template-columns: minmax(0, 1fr) auto;
		}
		.nav__mark-icon {
			width: 42px;
			height: 42px;
		}
		.nav__mark-text {
			font-size: 0.9rem;
		}
		.nav__mark-tag {
			display: none;
		}
		.nav__cta {
			padding: 0.55rem 0.7rem;
			font-size: 0.72rem;
		}
	}
</style>
