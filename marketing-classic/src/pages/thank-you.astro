---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="OdinPMP // Received // You're On The List"
	description="Your OdinPMP enlistment is in. We seat the first cohort by hand."
>
	<Nav />

	<main id="main" class="page">
		<section class="panel">
			<div class="panel__bg" aria-hidden="true">
				<img src="/images/thanks-forge.jpg" alt="" loading="lazy" />
			</div>

			<div class="panel__inner">
				<div class="panel__index mono">§ 99 // TRANSMISSION RECEIVED</div>

				<h1 class="panel__title display">
					ENLISTED.<br />
					<span class="panel__title-accent">WELCOME TO THE FORGE.</span>
				</h1>

				<p class="panel__copy">
					<span class="serif-it">A founder will read your entry.</span> We will use it to shape the
					v1 release and the first beta invitations. If you wrote something useful, expect a reply.
					If you wrote "looks cool" — expect silence and a beta key eventually.
				</p>

				<div class="receipt mono" aria-label="Receipt">
					<div class="receipt__row">
						<span>STATUS</span>
						<strong>QUEUED</strong>
					</div>
					<div class="receipt__row">
						<span>COHORT</span>
						<strong>FORGE-01</strong>
					</div>
					<div class="receipt__row">
						<span>SLOT</span>
						<strong>ASSIGNED ON REVIEW</strong>
					</div>
					<div class="receipt__row">
						<span>NEXT</span>
						<strong>WE EMAIL YOU</strong>
					</div>
				</div>

				<div class="actions">
					<a class="btn btn--primary" href="/">
						<span>BACK TO INDEX</span>
						<span aria-hidden="true">←</span>
					</a>
					<a class="btn btn--ghost-light" href="/#manifesto">
						<span>READ THE MANIFESTO</span>
						<span aria-hidden="true">↓</span>
					</a>
				</div>
			</div>
		</section>

		<section class="aftermath">
			<div class="aftermath__index mono">§ 00 // WHILE YOU WAIT</div>
			<h2 class="aftermath__title display">
				THREE WAYS<br />
				<span class="serif-it">to be useful</span><br />
				BEFORE WE OPEN.
			</h2>
			<ol class="moves">
				<li>
					<span class="moves__n display">01</span>
					<h3 class="moves__h display">TELL A TEAMMATE.</h3>
					<p>If you build software with people who hate their PM tool, send them <a href="/">odinpmp.com</a>.</p>
				</li>
				<li>
					<span class="moves__n display">02</span>
					<h3 class="moves__h display">WRITE THE GRIPE.</h3>
					<p>Email <a href="mailto:hello@odinpmp.com">hello@odinpmp.com</a> with your worst PM-tool story. It will go on a wall.</p>
				</li>
				<li>
					<span class="moves__n display">03</span>
					<h3 class="moves__h display">WATCH THE STATUS.</h3>
					<p>System status, beta dates, and forge updates live in the footer. We update when there's news.</p>
				</li>
			</ol>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	.page {
		max-width: 1400px;
		margin: 0 auto;
		padding: 3rem 1.5rem 0;
	}

	.panel {
		position: relative;
		overflow: hidden;
		border: 3px solid var(--ink);
		background: var(--ink);
		color: var(--paper);
	}
	.panel__bg {
		position: absolute;
		inset: 0;
		opacity: 0.28;
	}
	.panel__bg img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: grayscale(1) contrast(1.15);
	}
	.panel__inner {
		position: relative;
		padding: 4rem 2rem;
		max-width: 70rem;
	}
	.panel__index {
		display: inline-block;
		padding: 0.4rem 0.7rem;
		margin-bottom: 1.6rem;
		background: var(--ochre);
		color: var(--ink);
		font-size: 0.75rem;
		letter-spacing: 0.14em;
		font-weight: 700;
	}
	.panel__title {
		margin: 0;
		font-size: clamp(2.8rem, 8vw, 7rem);
		line-height: 0.9;
	}
	.panel__title-accent {
		color: var(--accent);
	}
	.panel__copy {
		margin: 1.5rem 0 0;
		max-width: 44rem;
		font-size: 1.1rem;
		line-height: 1.65;
		opacity: 0.88;
	}

	.receipt {
		margin: 2rem 0 0;
		max-width: 32rem;
		border: 3px solid var(--paper);
		background: rgba(255, 255, 255, 0.04);
	}
	.receipt__row {
		display: flex;
		justify-content: space-between;
		padding: 0.7rem 0.9rem;
		font-size: 0.78rem;
		letter-spacing: 0.14em;
		border-bottom: 2px dashed rgba(239, 236, 226, 0.35);
	}
	.receipt__row:last-child {
		border-bottom: none;
	}
	.receipt__row strong {
		color: var(--ochre);
		font-family: 'Archivo Black', sans-serif;
		letter-spacing: 0.04em;
	}

	.actions {
		margin-top: 2.2rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 1rem 1.4rem;
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		border: 3px solid var(--paper);
		transition: transform 0.08s ease, box-shadow 0.08s ease, background 0.15s;
	}
	.btn--primary {
		background: var(--accent);
		color: var(--paper);
		border-color: var(--accent);
	}
	.btn--primary:hover {
		background: var(--paper);
		color: var(--ink);
		border-color: var(--paper);
		transform: translate(-3px, -3px);
		box-shadow: 6px 6px 0 var(--accent);
	}
	.btn--ghost-light {
		background: transparent;
		color: var(--paper);
	}
	.btn--ghost-light:hover {
		background: var(--paper);
		color: var(--ink);
		transform: translate(-3px, -3px);
		box-shadow: 6px 6px 0 var(--accent);
	}

	/* ===== AFTERMATH ===== */
	.aftermath {
		margin-top: 4rem;
	}
	.aftermath__index {
		display: inline-block;
		padding: 0.4rem 0.7rem;
		margin-bottom: 1.4rem;
		background: var(--ink);
		color: var(--paper);
		font-size: 0.75rem;
		letter-spacing: 0.14em;
		font-weight: 700;
	}
	.aftermath__title {
		margin: 0;
		font-size: clamp(2.4rem, 6vw, 5rem);
	}
	.aftermath__title .serif-it {
		color: var(--accent);
		font-weight: 400;
	}
	.moves {
		list-style: none;
		padding: 0;
		margin: 2.5rem 0 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0;
		border: 3px solid var(--ink);
	}
	.moves li {
		padding: 1.6rem;
		border-right: 3px solid var(--ink);
		background: var(--paper-warm);
	}
	.moves li:last-child {
		border-right: none;
	}
	.moves li:nth-child(2) {
		background: var(--paper);
	}
	.moves__n {
		display: block;
		color: var(--accent);
		font-size: 3rem;
		line-height: 1;
		margin-bottom: 0.6rem;
	}
	.moves__h {
		margin: 0 0 0.6rem;
		font-size: 1.4rem;
		line-height: 1.05;
	}
	.moves p {
		margin: 0;
		font-size: 0.97rem;
		line-height: 1.55;
		color: var(--muted);
	}
	.moves a {
		color: var(--ink);
		border-bottom: 2px solid var(--accent);
		font-weight: 700;
	}

	@media (max-width: 880px) {
		.moves {
			grid-template-columns: 1fr;
		}
		.moves li {
			border-right: none;
			border-bottom: 3px solid var(--ink);
		}
		.moves li:last-child {
			border-bottom: none;
		}
	}
</style>
