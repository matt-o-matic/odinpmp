{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odinpmp.com/schemas/odin.review-package/v1.json",
  "title": "Odin review package manifest v1",
  "description": "manifest.json at the root of a review package zip. See docs/requirements-gathering/package-spec.md. Cross-references (file existence, directionId, screenIds, topicId, duplicate ids, one section per type) are checked in code after schema validation.",
  "type": "object",
  "required": ["schema", "track", "title", "summary", "sections"],
  "properties": {
    "schema": { "const": "odin.review-package/v1" },
    "track": { "enum": ["experience", "architecture"] },
    "title": { "$ref": "#/$defs/text120" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "basedOnRoundId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "generator": {
      "type": "object",
      "properties": {
        "tool": { "type": "string", "maxLength": 60 },
        "model": { "type": "string", "maxLength": 80 },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "additionalProperties": false
    },
    "feedbackDimensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "oneOf": [
          { "enum": ["type", "density", "hierarchy", "color", "branding", "behavior", "feasibility", "risk", "cost", "operability", "security"] },
          {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "label": { "type": "string", "minLength": 1, "maxLength": 40 },
              "help": { "type": "string", "maxLength": 200 }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/section" },
      "contains": {
        "type": "object",
        "properties": { "type": { "enum": ["screens", "directions", "flows", "questions"] } },
        "required": ["type"]
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "minLength": 1, "maxLength": 64 },
    "text120": { "type": "string", "minLength": 1, "maxLength": 120 },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$"
    },
    "markdown": { "type": "string", "minLength": 1 },
    "sectionBase": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "maxLength": 120 }
      }
    },
    "section": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["context", "references", "directions", "screens", "flows", "questions", "boundaries"] } },
      "allOf": [
        { "if": { "properties": { "type": { "const": "context" } } }, "then": { "$ref": "#/$defs/contextSection" } },
        { "if": { "properties": { "type": { "const": "references" } } }, "then": { "$ref": "#/$defs/referencesSection" } },
        { "if": { "properties": { "type": { "const": "directions" } } }, "then": { "$ref": "#/$defs/directionsSection" } },
        { "if": { "properties": { "type": { "const": "screens" } } }, "then": { "$ref": "#/$defs/screensSection" } },
        { "if": { "properties": { "type": { "const": "flows" } } }, "then": { "$ref": "#/$defs/flowsSection" } },
        { "if": { "properties": { "type": { "const": "questions" } } }, "then": { "$ref": "#/$defs/questionsSection" } },
        { "if": { "properties": { "type": { "const": "boundaries" } } }, "then": { "$ref": "#/$defs/boundariesSection" } }
      ]
    },
    "contextSection": {
      "$ref": "#/$defs/sectionBase",
      "type": "object",
      "required": ["body"],
      "properties": { "id": true, "type": true, "title": true, "body": { "type": "string", "minLength": 1, "maxLength": 8000 } },
      "unevaluatedProperties": false
    },
    "boundariesSection": {
      "$ref": "#/$defs/sectionBase",
      "type": "object",
      "required": ["body"],
      "properties": { "id": true, "type": true, "title": true, "body": { "type": "string", "minLength": 1, "maxLength": 4000 } },
      "unevaluatedProperties": false
    },
    "referencesSection": {
      "$ref": "#/$defs/sectionBase",
      "type": "object",
      "required": ["items"],
      "properties": {
        "id": true, "type": true, "title": true,
        "items": {
          "type": "array", "minItems": 1, "maxItems": 30,
          "items": {
            "type": "object",
            "required": ["title", "url", "inspected", "pattern"],
            "properties": {
              "title": { "type": "string", "minLength": 1, "maxLength": 160 },
              "url": { "type": "string", "pattern": "^https://", "maxLength": 2048 },
              "creator": { "type": "string", "maxLength": 120 },
              "inspected": { "type": "boolean" },
              "pattern": { "type": "string", "minLength": 1, "maxLength": 500 },
              "appliesTo": { "type": "string", "maxLength": 300 }
            },
            "additionalProperties": false
          }
        }
      },
      "unevaluatedProperties": false
    },
    "directionsSection": {
      "$ref": "#/$defs/sectionBase",
      "type": "object",
      "required": ["items"],
      "properties": {
        "id": true, "type": true, "title": true,
        "items": {
          "type": "array", "minItems": 2, "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["id", "title", "summary"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "title": { "type": "string", "minLength": 1, "maxLength": 80 },
              "summary": { "type": "string", "minLength": 1, "maxLength": 1500 },
              "tradeoffs": { "type": "string", "maxLength": 1500 },
              "screenIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
            },
            "additionalProperties": false
          }
        }
      },
      "unevaluatedProperties": false
    },
    "screensSection": {
      "$ref": "#/$defs/sectionBase",
      "type": "object",
      "required": ["items"],
      "properties": {
        "id": true, "type": true, "title": true,
        "items": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "$ref": "#/$defs/screen" } }
      },
      "unevaluatedProperties": false
    },
    "screen": {
      "type": "object",
      "required": ["id", "title", "kind", "src", "alt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "kind": { "enum": ["image", "prototype"] },
        "src": { "$ref": "#/$defs/path" },
        "alt": { "type": "string", "minLength": 1, "maxLength": 300 },
        "width": { "type": "integer", "minimum": 200, "maximum": 8000 },
        "height": { "type": "integer", "minimum": 200, "maximum": 8000 },
        "viewport": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 320, "maximum": 3840 },
            "height": { "type": "integer", "minimum": 320, "maximum": 3840 }
          },
          "additionalProperties": false
        },
        "states": {
          "type": "array", "minItems": 1, "maxItems": 30,
          "items": {
            "type": "object",
            "required": ["key", "label"],
            "properties": { "key": { "$ref": "#/$defs/id" }, "label": { "type": "string", "minLength": 1, "maxLength": 60 } },
            "additionalProperties": false
          }
        },
        "directionId": { "$ref": "#/$defs/id" },
        "rationale": { "type": "string", "maxLength": 1500 },
        "changeNote": { "type": "string", "maxLength": 1000 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "image" } } },
          "then": {
            "type": "object",
            "required": ["width", "height"],
            "properties": { "src": { "type": "string", "pattern": "\\.(png|jpe?g|webp|gif|svg)$" }, "viewport": false, "states": false }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "prototype" } } },
          "then": {
            "type": "object",
            "required": ["viewport"],
            "properties": { "src": { "type": "string", "pattern": "\\.html$" }, "width": false, "height": false }
          }
        }
      ]
    },
    "flowsSection": {
      "$ref": "#/$defs/sectionBase",
      "type": "object",
      "required": ["items"],
      "properties": {
        "id": true, "type": true, "title": true,
        "items": {
          "type": "array", "minItems": 1, "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["id", "title", "mermaid"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "title": { "type": "string", "minLength": 1, "maxLength": 80 },
              "mermaid": { "type": "string", "minLength": 1, "maxLength": 20000 },
              "description": { "type": "string", "maxLength": 1500 }
            },
            "additionalProperties": false
          }
        }
      },
      "unevaluatedProperties": false
    },
    "questionsSection": {
      "$ref": "#/$defs/sectionBase",
      "type": "object",
      "required": ["items"],
      "properties": {
        "id": true, "type": true, "title": true,
        "items": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/question" } }
      },
      "unevaluatedProperties": false
    },
    "question": {
      "type": "object",
      "required": ["id", "prompt", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 500 },
        "kind": { "enum": ["single", "multi", "text", "scale"] },
        "options": {
          "type": "array", "minItems": 2, "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "type": "string", "minLength": 1, "maxLength": 120 } },
            "additionalProperties": false
          }
        },
        "scale": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": -10, "maximum": 10 },
            "max": { "type": "integer", "minimum": -10, "maximum": 10 },
            "minLabel": { "type": "string", "maxLength": 40 },
            "maxLabel": { "type": "string", "maxLength": 40 }
          },
          "additionalProperties": false
        },
        "topicId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "help": { "type": "string", "maxLength": 300 }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "kind": { "enum": ["single", "multi"] } } }, "then": { "type": "object", "required": ["options"], "properties": { "scale": false } } },
        { "if": { "properties": { "kind": { "const": "scale" } } }, "then": { "type": "object", "required": ["scale"], "properties": { "options": false } } },
        { "if": { "properties": { "kind": { "const": "text" } } }, "then": { "properties": { "options": false, "scale": false } } }
      ]
    }
  }
}
