{
  "name": "odinpmp",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "scripts": {
    "test": "npm run test:pr",
    "bootstrap": "npm run install:backend && npm run install:frontend && npm run install:marketing && npm run install:clarification-inbound-lambda",
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend",
    "install:marketing": "npm install --prefix marketing",
    "install:clarification-inbound-lambda": "npm install --prefix tools/clarification-inbound-lambda",
    "dev": "concurrently -k --names api,app,marketing --prefix-colors blue,green,magenta \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\" \"npm --prefix marketing run dev\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:marketing": "npm --prefix marketing run dev",
    "dev:marketing-classic": "npm --prefix marketing-classic run dev",
    "build": "npm run build:backend && npm run build:frontend && npm run build:marketing",
    "build:backend": "npm --prefix backend run build",
    "build:clarification-inbound-lambda": "npm --prefix tools/clarification-inbound-lambda run build:zip",
    "build:frontend": "npm --prefix frontend run build",
    "build:marketing": "npm --prefix marketing run build",
    "build:marketing-classic": "npm --prefix marketing-classic run build",
    "start:backend": "npm --prefix backend run start",
    "mcp": "node backend/src/mcp/stdio.js",
    "test:mcp": "npm --prefix backend run test:mcp",
    "db-reset": "npm --prefix backend run job:db-reset --",
    "schema-parity": "npm --prefix backend run job:schema-parity --",
    "test:changed": "node tools/test/run.mjs --profile changed",
    "test:autonomous": "node tools/test/run.mjs",
    "test:pr": "node tools/test/run.mjs --profile pr",
    "test:nightly": "node tools/test/run.mjs --profile nightly",
    "test:weekly": "node tools/test/run.mjs --profile weekly",
    "test:release": "node tools/test/run.mjs --profile release",
    "test:postdeploy": "node tools/test/run.mjs --profile postdeploy",
    "test:browser": "npm --prefix frontend run test:e2e",
    "test:e2e": "npm --prefix frontend run test:e2e --",
    "test:eval": "node tools/test/eval.mjs",
    "test:integration": "node tools/test/run.mjs --profile integration",
    "test:coverage": "node tools/test/run.mjs --profile coverage",
    "test:clarification-inbound-lambda": "npm --prefix tools/clarification-inbound-lambda test",
    "preview:frontend": "npm --prefix frontend run preview",
    "preview:marketing": "npm --prefix marketing run preview"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
