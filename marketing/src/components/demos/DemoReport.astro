---
import Demo from './Demo.astro';
import HarborReturns from './HarborReturns.astro';
---

<Demo label="A tester reports a bug from the live website with an annotated screenshot, the console and the page trail, and it becomes an Odin ticket." url="harborandpine.example/returns/items">
	<div class="site">
		<HarborReturns version="live" />
		<div class="flash" data-at="2450" data-off="2750" data-fx="flash"></div>
		<div class="capture" data-at="2700" data-off="7650" data-fx="fade">
			<div class="toolbar">
				<span class="t is-picked">Arrow</span><span class="t">Box</span><span class="t">Pen</span><span class="t">Highlight</span><span class="t">Text</span>
			</div>
			<svg class="ink" viewBox="0 0 1000 625" preserveAspectRatio="none">
				<path d="M 570 250 C 700 250 820 300 880 365" fill="none" stroke="#ff4f6d" stroke-width="4" stroke-linecap="round" data-at="3400" data-fx="draw" style="--len:360"></path>
				<path d="M 863 358 L 880 365 L 875 348" fill="none" stroke="#ff4f6d" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" data-at="4200" data-fx="draw" style="--len:80"></path>
			</svg>
			<span class="scribble" data-at="4300" data-type data-speed="40">Nothing happens on Safari</span>
		</div>
		<span class="bug" data-bug>
			<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12 4a3 3 0 0 1 3 3v.3A5 5 0 0 1 17 9.6l2.3-1.3.9 1.6-2.6 1.5c.1.4.1.8.1 1.1v1h3v1.9h-3v.6c0 .5-.1 1-.2 1.5l2.6 1.5-.9 1.6-2.4-1.4A5 5 0 0 1 12 21a5 5 0 0 1-4.8-3.6l-2.4 1.4-.9-1.6 2.6-1.5c-.1-.5-.2-1-.2-1.5v-.6H3.3v-1.9h3v-1c0-.4 0-.7.1-1.1L3.8 8.1l.9-1.6L7 7.8a5 5 0 0 1 2-2.5V7a3 3 0 0 1 3-3Z"></path></svg>
		</span>
		<aside class="panel app" data-at="5000" data-off="7650" data-fx="slide">
			<header>
				<b>Report a bug</b>
				<span class="a-small a-muted">Harbor & Pine portal</span>
			</header>
			<div class="shot"><span>Screenshot, 1 arrow, 1 note</span></div>
			<p class="a-label">Title</p>
			<p class="a-input title" data-at="5300" data-type data-speed="26">Continue to label does nothing</p>
			<div class="tabs"><span class="is-current">Console <i>2</i></span><span>Page trail <i>4</i></span><span>Files <i>0</i></span></div>
			<ul class="log">
				<li class="err">TypeError: undefined is not an object (evaluating 'order.orderId') <em>returns.js:88</em></li>
				<li class="warn">Order cache restored from back-forward cache</li>
			</ul>
			<ul class="trail">
				<li>/account/orders</li>
				<li>/orders/HP-20931</li>
				<li>/returns/start</li>
				<li>/returns/items</li>
			</ul>
			<span class="a-btn a-btn--primary send" data-at="7300" data-fx="press">Send report</span>
		</aside>
		<div class="sent app" data-at="7700" data-fx="pop">Sent. Your report is <b>BR-142</b>, and we'll email you as it changes.</div>
		<div class="ticket app a-card" data-at="8600" data-fx="rise">
			<span class="a-label">New in Odin tickets</span>
			<p><b>BR-142</b> Continue to label does nothing</p>
			<p class="chips"><span class="a-chip a-chip--bad">Defect</span><span class="a-chip a-chip--warn">S2</span><span class="a-chip">New</span><span class="a-chip a-chip--accent">From Bug Reporter</span></p>
		</div>
		<i class="cursor" data-path="0:60,80 500:90,61 800:click 1300:click 1900:95,93 2400:click 3300:57,40 4300:88,58 6600:82,93 7300:click"></i>
	</div>
</Demo>

<style>
	.site {
		position: absolute;
		inset: 0;
	}
	.site :global(.hp__cta) {
		box-shadow: 0 0 0 0 rgba(31, 77, 58, 0.3);
	}
	.flash {
		position: absolute;
		inset: 0;
		background: #fff;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.12s ease;
		z-index: 20;
	}
	.flash.is-on {
		opacity: 0.85;
	}
	.capture {
		position: absolute;
		inset: 0;
		z-index: 10;
		box-shadow: inset 0 0 0 3px #ff4f6d;
		background: rgba(7, 17, 31, 0.06);
		opacity: 0;
		transition: opacity 0.3s ease;
	}
	.capture.is-on {
		opacity: 1;
	}
	.toolbar {
		position: absolute;
		left: 50%;
		top: 58px;
		display: flex;
		gap: 2px;
		padding: 4px;
		border-radius: 10px;
		background: #07111f;
		transform: translateX(-50%);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
	}
	.t {
		padding: 4px 10px;
		border-radius: 7px;
		color: #c4d2e8;
		font-family: var(--font-app);
		font-size: 12px;
	}
	.t.is-picked {
		background: #ff4f6d;
		color: #fff;
	}
	.ink {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.scribble {
		position: absolute;
		left: 370px;
		top: 222px;
		padding: 3px 8px;
		border-radius: 6px;
		background: #ff4f6d;
		color: #fff;
		font-family: var(--font-app);
		font-size: 14px;
		font-weight: 650;
	}
	.scribble:empty {
		display: none;
	}
	.bug {
		position: absolute;
		right: 22px;
		bottom: 22px;
		z-index: 12;
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background: #07111f;
		color: #f2b636;
		box-shadow: 0 10px 24px rgba(0, 0, 0, 0.3);
	}
	.panel {
		position: absolute;
		top: 12px;
		right: 12px;
		bottom: 12px;
		z-index: 15;
		display: flex;
		flex-direction: column;
		gap: 8px;
		width: 330px;
		padding: 14px;
		border-radius: 14px;
		background: var(--a-surface);
		border: 1px solid var(--a-line);
		box-shadow: 0 30px 60px rgba(7, 17, 31, 0.35);
		transform: translateX(380px);
		transition: transform 0.7s var(--ease-out);
	}
	.panel.is-on {
		transform: none;
	}
	.panel header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
	}
	.shot {
		display: grid;
		place-items: end start;
		height: 92px;
		padding: 6px;
		border-radius: 8px;
		background:
			linear-gradient(transparent 60%, rgba(7, 17, 31, 0.5)),
			linear-gradient(90deg, #fbfaf7 0 70%, #1f4d3a 70% 100%);
		background-size: cover;
		border: 1px solid var(--a-line);
		color: #fff;
		font-size: 11px;
		font-weight: 600;
	}
	.title {
		min-height: 32px;
	}
	.tabs {
		display: flex;
		gap: 4px;
		font-size: 11.5px;
		border-bottom: 1px solid var(--a-line);
	}
	.tabs span {
		padding: 4px 8px;
		color: var(--a-muted);
	}
	.tabs i {
		font-style: normal;
		font-weight: 700;
	}
	.tabs .is-current {
		color: var(--a-ink);
		border-bottom: 2px solid var(--a-accent);
		font-weight: 600;
	}
	.log,
	.trail {
		display: grid;
		gap: 4px;
		margin: 0;
		padding: 0;
		list-style: none;
		font-family: var(--font-mono);
		font-size: 10px;
	}
	.log li {
		padding: 5px 7px;
		border-radius: 6px;
	}
	.log em {
		display: block;
		font-style: normal;
		color: var(--a-muted);
	}
	.err {
		background: var(--a-bad-soft);
		color: var(--a-bad);
	}
	.warn {
		background: var(--a-warn-soft);
		color: var(--a-warn);
	}
	.trail li {
		padding-left: 10px;
		border-left: 2px solid var(--a-line-2);
		color: var(--a-muted);
	}
	.trail li:last-child {
		border-color: var(--a-accent);
		color: var(--a-ink);
	}
	.send {
		margin-top: auto;
		justify-content: center;
	}
	.sent {
		position: absolute;
		left: 50%;
		bottom: 26px;
		z-index: 16;
		padding: 10px 16px;
		border-radius: 999px;
		background: #07111f;
		color: #edf3fb;
		font-size: 13px;
		translate: -50% 0;
		box-shadow: 0 14px 30px rgba(0, 0, 0, 0.3);
	}
	.js .panel[data-fx='slide'].is-on ~ .sent.is-on {
		z-index: 16;
	}
	.ticket {
		position: absolute;
		right: 22px;
		top: 62px;
		z-index: 17;
		display: grid;
		gap: 5px;
		width: 340px;
		padding: 12px 14px;
		opacity: 0;
		transform: translateX(60px);
		transition: opacity 0.4s ease, transform 0.7s var(--ease-out);
	}
	.ticket.is-on {
		opacity: 1;
		transform: none;
	}
	.chips {
		display: flex;
		gap: 5px;
	}
</style>
