---
import '@fontsource-variable/hubot-sans/wdth.css';
import '@fontsource-variable/mona-sans/wdth.css';
import '@fontsource-variable/martian-mono/index.css';
import '@fontsource-variable/space-grotesk/index.css';
import '../styles/global.css';
import '../styles/app.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Odin: from the first question to the merged fix',
	description = 'Odin is one system for building software with clients. Stakeholders review real screens, plans cite their decisions, sprints run on the same projects, and bugs reported on the live site come back as pull requests.',
} = Astro.props;
const site = 'https://odinpmp.com';
const canonical = new URL(Astro.url.pathname, site).toString();
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			(() => {
				let theme = 'dark';
				try {
					const saved = localStorage.getItem('odin-theme');
					theme = saved === 'light' || saved === 'dark' ? saved : matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
				} catch {}
				document.documentElement.dataset.theme = theme;
				document.documentElement.classList.add('js');
			})();
		</script>
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/x-icon" href="/favicon.ico?v=odin-mark" />
		<link rel="apple-touch-icon" href="/brand/odin-mark.png" />
		<meta name="theme-color" content="#08101f" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#f1f4f9" media="(prefers-color-scheme: light)" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="OdinPMP" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={`${site}/og.png`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<slot />
	</body>
</html>
