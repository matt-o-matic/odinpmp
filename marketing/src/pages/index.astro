---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/home/Hero.astro';
import Journey from '../components/home/Journey.astro';
import Tour from '../components/home/Tour.astro';
import Ravens from '../components/home/Ravens.astro';
import Agents from '../components/home/Agents.astro';
import BugDemo from '../components/home/BugDemo.astro';
import Platform from '../components/home/Platform.astro';
import Trust from '../components/home/Trust.astro';
import Closing from '../components/home/Closing.astro';
---

<Base>
	<Nav home />
	<main id="main">
		<Hero />
		<Journey />
		<Tour />
		<Ravens />
		<Agents />
		<BugDemo />
		<Platform />
		<Trust />
		<Closing />
	</main>
	<Footer />
</Base>
