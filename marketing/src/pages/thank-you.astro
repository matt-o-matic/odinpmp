---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Request received | Odin" description="Your request for Odin access is in.">
	<Nav />
	<main id="main" class="thanks">
		<div class="wrap thanks__inner">
			<i class="gem thanks__gem" aria-hidden="true"></i>
			<h1>Your request is in.</h1>
			<p>
				Someone on the team will read it and get back to you by email.
			</p>
			<div class="thanks__actions">
				<a class="btn" href="/#loop">Follow the loop</a>
				<a class="btn btn--quiet" href="/">Back to the home page</a>
			</div>
		</div>
	</main>
	<Footer />
</Base>

<style>
	.thanks {
		display: grid;
		min-height: 80vh;
		place-items: center;
		padding: calc(var(--nav-h) + 4rem) 0 6rem;
		text-align: center;
		background: radial-gradient(40% 40% at 50% 40%, var(--ice-soft), transparent 70%);
	}
	.thanks__inner {
		display: grid;
		justify-items: center;
		gap: 1.5rem;
	}
	.thanks__gem {
		font-size: 2rem;
		animation: settle 1.4s var(--ease-out) both;
	}
	@keyframes settle {
		from {
			transform: translateY(-40px) rotate(225deg);
			opacity: 0;
		}
		to {
			transform: rotate(45deg);
			opacity: 1;
		}
	}
	h1 {
		font-size: var(--step-5);
		font-weight: 800;
		letter-spacing: -0.035em;
	}
	p {
		max-width: 48ch;
		font-size: var(--step-1);
		color: var(--ink-2);
	}
	.thanks__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
	}
</style>
