---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { stations } from '../data/loop';

// The marketing site and the API share a host in production, so the form posts to /api on the same origin.
const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? (import.meta.env.DEV ? 'http://localhost:3001' : '');
---

<Base title="Request access to Odin" description="Tell us about your team and the project you'd bring to Odin. Someone on the team reads every request.">
	<Nav />
	<main id="main" class="signup">
		<div class="wrap signup__grid">
			<section class="signup__intro">
				<h1>Request access.</h1>
				<p>
					Tell us about your team and the project you'd bring to Odin. Someone on the team reads every request.
				</p>
				<ol class="mini-loop" aria-label="What your project would go through in Odin">
					{stations.map((station) => <li><b>{station.label}</b> {station.summary}</li>)}
				</ol>
			</section>

			<form class="form" id="waitlist-form" novalidate>
				<div class="field">
					<label for="name">Name</label>
					<input id="name" name="name" autocomplete="name" required maxlength="120" />
				</div>
				<div class="field">
					<label for="email">Work email</label>
					<input id="email" name="email" type="email" autocomplete="email" required maxlength="320" />
				</div>
				<div class="field">
					<label for="company">Company <span>optional</span></label>
					<input id="company" name="company" autocomplete="organization" maxlength="100" />
				</div>
				<div class="split">
					<div class="field">
						<label for="companySize">Company size <span>optional</span></label>
						<select id="companySize" name="companySize">
							<option value="">Choose one</option>
							<option value="1-10">1 to 10</option>
							<option value="11-50">11 to 50</option>
							<option value="51-200">51 to 200</option>
							<option value="201-1000">201 to 1,000</option>
							<option value="1000+">More than 1,000</option>
						</select>
					</div>
					<div class="field">
						<label for="industry">What you build <span>optional</span></label>
						<input id="industry" name="industry" maxlength="100" />
					</div>
				</div>
				<div class="field">
					<label for="comments">The project you'd bring <span>optional</span></label>
					<textarea id="comments" name="comments" rows="5" maxlength="2000" placeholder="Who are the stakeholders, and what gets in the way today?"></textarea>
				</div>
				<div class="trap" aria-hidden="true">
					<label for="website">Leave this empty</label>
					<input id="website" name="website" tabindex="-1" autocomplete="off" />
				</div>
				<label class="check">
					<input id="betaInterest" name="betaInterest" type="checkbox" />
					<span>I'd like to try new features early, rough edges included.</span>
				</label>
				<p class="status" id="form-status" role="status" aria-live="polite"></p>
				<button class="btn submit" type="submit">Request access</button>
				<p class="fine">
					We use these details to review your request. See the <a href="/privacy/">privacy policy</a> and
					<a href="/terms/">terms of service</a>.
				</p>
				<noscript><p class="status" data-state="error">Sending this form needs JavaScript. You can also email hello@odinpmp.com.</p></noscript>
			</form>
		</div>
	</main>
	<Footer />
</Base>

<script define:vars={{ apiBase }}>
	const form = document.querySelector('#waitlist-form');
	const status = document.querySelector('#form-status');

	if (form instanceof HTMLFormElement && status instanceof HTMLElement) {
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const button = form.querySelector('button[type="submit"]');
			const data = new FormData(form);
			const payload = {
				name: String(data.get('name') ?? '').trim(),
				email: String(data.get('email') ?? '').trim(),
				company: String(data.get('company') ?? '').trim(),
				companySize: String(data.get('companySize') ?? '').trim(),
				industry: String(data.get('industry') ?? '').trim(),
				comments: String(data.get('comments') ?? '').trim(),
				betaInterest: data.get('betaInterest') === 'on',
				website: String(data.get('website') ?? ''),
			};

			if (!payload.name || !payload.email || !form.email.checkValidity()) {
				status.dataset.state = 'error';
				status.textContent = !payload.name ? 'Add your name.' : 'Add a work email address, like you@company.com.';
				(!payload.name ? form.name : form.email).focus();
				return;
			}

			status.dataset.state = 'pending';
			status.textContent = 'Sending your request…';
			if (button instanceof HTMLButtonElement) button.disabled = true;

			try {
				const response = await fetch(`${apiBase}/api/public/waitlist`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(payload),
				});
				if (!response.ok) {
					const body = await response.json().catch(() => ({}));
					if (response.status === 400) throw new Error('Check your name and email address.');
					throw new Error(body.error || 'Your request didn’t go through.');
				}
				window.location.href = '/thank-you';
			} catch (error) {
				status.dataset.state = 'error';
				status.textContent = `${error instanceof Error ? error.message : 'Your request didn’t go through.'} Try again, or email hello@odinpmp.com.`;
			} finally {
				if (button instanceof HTMLButtonElement) button.disabled = false;
			}
		});
	}
</script>

<style>
	.signup {
		padding: calc(var(--nav-h) + clamp(3rem, 7vw, 6rem)) 0 clamp(4rem, 8vw, 7rem);
	}
	.signup__grid {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: start;
	}
	h1 {
		font-size: var(--step-5);
		font-weight: 800;
		letter-spacing: -0.035em;
	}
	.signup__intro > p {
		max-width: 40ch;
		margin-top: 1.5rem;
		font-size: var(--step-1);
		color: var(--ink-2);
	}
	.mini-loop {
		position: relative;
		display: grid;
		gap: 0.9rem;
		margin: 2.5rem 0 0;
		padding: 0 0 0 1.75rem;
		list-style: none;
		font-size: var(--step--1);
		color: var(--muted);
	}
	.mini-loop::before {
		content: '';
		position: absolute;
		left: 5px;
		top: 0.5rem;
		bottom: 0.5rem;
		width: 1px;
		background: var(--line-2);
	}
	.mini-loop::after {
		content: '';
		position: absolute;
		left: 1px;
		top: 0.35rem;
		width: 9px;
		height: 9px;
		background: var(--gold);
		transform: rotate(45deg);
		box-shadow: 0 0 0 3px var(--gold-glow);
		animation: descend 9s var(--ease-in-out) infinite;
	}
	@keyframes descend {
		0%,
		8% {
			top: 0.35rem;
		}
		92%,
		100% {
			top: calc(100% - 0.95rem);
		}
	}
	.mini-loop li {
		position: relative;
	}
	.mini-loop li::before {
		content: '';
		position: absolute;
		left: calc(-1.75rem + 3px);
		top: 0.55em;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--line-2);
	}
	.mini-loop b {
		color: var(--ink);
		font-weight: 650;
	}

	.form {
		display: grid;
		gap: 1.1rem;
		padding: clamp(1.5rem, 3vw, 2.5rem);
		border-radius: var(--radius-l);
		border: 1px solid var(--line);
		background: var(--raised);
		box-shadow: var(--shadow-2);
	}
	.field {
		display: grid;
		gap: 0.4rem;
	}
	.split {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}
	label {
		font-size: var(--step--1);
		font-weight: 600;
	}
	label span {
		font-weight: 400;
		color: var(--muted);
	}
	input,
	select,
	textarea {
		width: 100%;
		min-height: 46px;
		padding: 0.65rem 0.85rem;
		border: 1px solid var(--line-2);
		border-radius: 10px;
		background: var(--bg);
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}
	textarea {
		resize: vertical;
	}
	input:focus,
	select:focus,
	textarea:focus {
		outline: none;
		border-color: var(--ice);
		box-shadow: 0 0 0 3px var(--ice-soft);
	}
	/* Off screen rather than display:none, which some bots know to skip. */
	.trap {
		position: absolute;
		left: -10000px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}
	.check {
		display: flex;
		align-items: flex-start;
		gap: 0.7rem;
		font-weight: 400;
		color: var(--ink-2);
		cursor: pointer;
	}
	.check input {
		width: 18px;
		min-height: 18px;
		height: 18px;
		margin-top: 0.2rem;
		accent-color: var(--gold);
	}
	.status {
		min-height: 1.4em;
		font-size: var(--step--1);
		color: var(--muted);
	}
	.status[data-state='error'] {
		color: var(--bug);
	}
	.submit {
		justify-self: start;
	}
	.submit:disabled {
		opacity: 0.6;
		cursor: progress;
	}
	.fine {
		font-size: var(--step--2);
		color: var(--muted);
	}
	@media (max-width: 860px) {
		.signup__grid,
		.split {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.mini-loop::after {
			animation: none;
		}
	}
</style>
